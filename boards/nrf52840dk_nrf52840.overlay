//Defines the SPI instance and CS pin for the MAX30001G (nned to double check pins based on hw)

&spi1 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    cs-gpios = <&gpio0 29 GPIO_ACTIVE_LOW>;  
    pinctrl-0 = <&spi1_default>;
    pinctrl-1 = <&spi1_sleep>;
    pinctrl-names = "default", "sleep";

    spi-device@0 {
        compatible = "nordic,nrf-spi-device";
        reg = <0>;
        spi-max-frequency = <8000000>;
    };
};

&pinctrl {
    spi1_default: spi1_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 13)>,   // SCK on P0.13
                    <NRF_PSEL(SPIM_MOSI, 0, 14)>,  // MOSI on P0.14
                    <NRF_PSEL(SPIM_MISO, 0, 15)>;  // MISO on P0.15
            nordic,drive-mode = <NRF_DRIVE_S0S1>;
        };
    };

    spi1_sleep: spi1_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 13)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 14)>,
                    <NRF_PSEL(SPIM_MISO, 0, 15)>;
            low-power-enable;
        };
    };
};


